# Sistema de Cotización — instancia PROPIA (ING-COT-003 §6).
# Base de datos y SECRET_KEY distintas de las de Control de Proyecto:
# las cuentas de usuario de una instancia no sirven en la otra.

DATABASE_URL=postgresql+psycopg2://cotizacion:CAMBIAR@db:5432/sistema_cotizacion
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NOMBRE=Administrador

REQUIRE_2FA=true
CORS_ORIGINS=*
TRUSTED_PROXIES=127.0.0.1,::1
STORAGE_DIR=./data

# Alertas de seguridad a administradores (opcional).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USUARIO=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Traspaso de ofertas ganadas por el MCP (MASTER CONTROL PROJECT).
# Preferido: URL, token y SBC único en Generales (paso 16, solo admin).
# Alta del nodo en el MCP: paso 28 → nodo con rol "cotizacion"; el token se
# muestra una sola vez. Vacío aquí = se usa lo de Generales; si ambos vacíos,
# solo queda la descarga manual del archivo.
MCP_URL=
MCP_TOKEN=
MCP_POLL_SECONDS=60

# OCR / generación de partidas (también se puede guardar cifrada en Generales).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bot de Telegram (preferido en Generales). Token de @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_POLL_SECONDS=3
TELEGRAM_EMPAREJAR_TTL_MIN=15

# OnlyOffice: el mismo Document Server del NUC que usa Control de Proyecto.
# ONLYOFFICE_APP_URL es la API de ESTA instancia (:8100), no la de CP (:8000).
# El secreto JWT se guarda cifrado en Generales; vacío aquí = se usa el de Generales.
ONLYOFFICE_URL=
ONLYOFFICE_APP_URL=
ONLYOFFICE_JWT_SECRET=
